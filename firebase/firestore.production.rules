rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == me();
      allow delete: if false;

      match /followers/{otherUid} {
        allow read: if signedIn();
        allow write: if signedIn() && (uid == me() || otherUid == me());
      }
      match /following/{otherUid} {
        allow read: if signedIn();
        allow write: if signedIn() && uid == me();
      }
      match /blocked/{otherUid} {
        allow read, write: if signedIn() && uid == me();
      }
      match /subscriptionPlans/{planId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && uid == me();
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update, delete: if signedIn() && resource.data.authorId == me();

      match /likes/{userId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && userId == me();
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update, delete: if signedIn() && resource.data.authorId == me();
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update, delete: if signedIn() && resource.data.authorId == me();
    }

    match /conversations/{conversationId} {
      allow read, create, update: if signedIn() &&
        (resource.data.members.hasAny([me()]) ||
         request.resource.data.members.hasAny([me()]));
      match /messages/{messageId} {
        allow read, create: if signedIn() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.members.hasAny([me()]);
        allow update, delete: if signedIn() &&
          resource.data.senderId == me();
      }
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == me();
      allow create: if signedIn() && request.resource.data.userId == me();
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == me();
      allow read: if false;
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sellerId == me();
      allow update, delete: if signedIn() && resource.data.sellerId == me();
    }

    match /payoutRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == me();
      allow read: if signedIn() && resource.data.userId == me();
      allow update, delete: if false;
    }

    match /creatorEarnings/{uid}/transactions/{transactionId} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    match /monetizationLedger/{eventId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
